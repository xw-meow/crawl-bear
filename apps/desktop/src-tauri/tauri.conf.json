{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CrawlBear",
  "version": "0.3.2",
  "identifier": "com.crawlbear.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "超级爬爬熊 · CrawlBear",
        "width": 1240,
        "height": 900,
        "minWidth": 980,
        "minHeight": 700,
        "center": true,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Utility",
    "shortDescription": "CrawlBear — website media crawler",
    "longDescription": "CrawlBear (超级爬爬熊) discovers images, videos, audio and fonts on any website, then saves selected media to a local folder."
  }
}
