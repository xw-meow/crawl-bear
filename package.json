{
  "name": "crawl-bear",
  "version": "0.3.2",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev:desktop": "pnpm --filter @crawl-bear/desktop tauri dev",
    "dev:web": "pnpm --filter @crawl-bear/website dev",
    "build": "pnpm -r build",
    "build:desktop": "pnpm --filter @crawl-bear/desktop exec tauri build --bundles app",
    "build:web": "pnpm --filter @crawl-bear/website build",
    "assets": "python3 scripts/prepare_assets.py",
    "test:rust": "cargo test --manifest-path apps/desktop/src-tauri/Cargo.toml --lib",
    "package:macos": "bash scripts/package_macos.sh"
  }
}
